# Copy to .env.local for development. Set real values in Vercel for
# Preview (staging) and Production. Never commit real secrets.
# Every integration is optional: the site works without it and switches
# the feature on as soon as its values are present.

# --- Site ---------------------------------------------------------------
# Public URL once the domain is confirmed (canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=
# "off" hides internal "Content needed" notes. Set to off in production.
NEXT_PUBLIC_CONTENT_NOTES=
# Fallback hero video URL (the CMS field takes priority)
NEXT_PUBLIC_HERO_VIDEO_URL=

# --- CMS (Sanity) -------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the Sanity webhook → /api/revalidate
SANITY_REVALIDATE_SECRET=

# --- Database (Postgres / Neon), server only ----------------------------
# Use Neon's pooled connection string in production.
DATABASE_URL=
# Salt for hashing IP addresses (any long random string)
IP_HASH_SALT=

# --- Email delivery (Resend), server only -------------------------------
# FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
FORMS_FROM_EMAIL=
FORMS_TO_EMAIL=
# Optional: separate inbox for Fusion Solutions Hub quote requests
FSH_QUOTES_TO_EMAIL=

# --- Newsletter (Brevo), server only ------------------------------------
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Analytics (Google Analytics 4) -------------------------------------
# Loaded only after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=

# --- Payments (Paystack) — not connected yet ----------------------------
# PAYSTACK_SECRET_KEY=
