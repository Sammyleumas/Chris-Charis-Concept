# Copy to .env.local for development. Set real values in Vercel for
# staging/production. Never commit real secrets.

# Public site URL once the domain is confirmed (canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=

# Hero background video: approved, externally hosted MP4/WebM (e.g. Cloudinary)
NEXT_PUBLIC_HERO_VIDEO_URL=

# "off" hides internal "Content needed" notes. Set to off in production.
NEXT_PUBLIC_CONTENT_NOTES=

# Newsletter (Brevo), server only
BREVO_API_KEY=
BREVO_LIST_ID=

# Added in later phases: Sanity, Postgres (Neon), Resend, Paystack, Turnstile, GA4
